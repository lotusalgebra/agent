<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX Toolset v3 source for the LOTUS Agent Child MSI installer.

  Build pipeline (run on a Windows PC with WiX 3.x installed):
    1. pyinstaller packaging\lotus-child.spec --clean --noconfirm
       (produces dist\lotus-child\ with lotus-child.exe + _internal files)

    2. candle -ext WixUIExtension packaging\windows\lotus-child.wxs ^
              -out build\lotus-child.wixobj

    3. light -ext WixUIExtension -cultures:en-us ^
             build\lotus-child.wixobj ^
             -out dist\lotus-child-1.0.0.msi

  UpgradeCode is a FIXED GUID — never change it. If you change it,
  Windows sees future installers as unrelated products and you'll end
  up with two installations side-by-side. Generate once via `uuidgen`
  and keep forever.

  Product/Id is "*" so WiX auto-generates a new ProductCode GUID per
  version — required for MSI major-upgrade semantics.
-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="LOTUS Agent Child"
      Language="1033"
      Version="1.0.0.0"
      Manufacturer="Lotus Algebra"
      UpgradeCode="5DC9F8C3-1E27-4B8F-A3F1-B4C8A2D1F903">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64"
        Description="LOTUS Agent Child — distributed worker for the LOTUS pipeline mesh"
        Comments="Built from PyInstaller bundle"
        Manufacturer="Lotus Algebra" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Major-upgrade: newer version replaces older; reject downgrade. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- ─── Install target: C:\Program Files\LOTUS Agent\Child\ ──── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPMANUFACTURERFOLDER" Name="LOTUS Agent">
          <Directory Id="INSTALLFOLDER" Name="Child" />
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="APPSHORTCUTFOLDER" Name="LOTUS Agent" />
      </Directory>

      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- ─── Payload: harvested from dist/lotus-child/ by heat.exe ──
         We reference a single generated `ComponentGroupRef` which
         is produced by `heat.exe dir dist\lotus-child ...` during
         build. See build.bat for the heat invocation. The fragment
         is included below via <?include ...?>. -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- heat.exe output gets linked in via -ext + autogenerated
           harvest file; see build.bat. -->
    </ComponentGroup>

    <!-- Shortcuts: Start Menu (always) + Desktop (user-selectable). -->
    <DirectoryRef Id="APPSHORTCUTFOLDER">
      <Component Id="StartMenuShortcuts"
                 Guid="75F1DA29-3F63-4C2C-8D30-B27C8B7E9C11">
        <Shortcut Id="StartChildShortcut"
                  Name="Start LOTUS Child"
                  Description="Launch the LOTUS Agent child process"
                  Target="[INSTALLFOLDER]lotus-child.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="ConfigureChildShortcut"
                  Name="Configure LOTUS Child"
                  Description="Re-run the child configuration wizard"
                  Target="[INSTALLFOLDER]lotus-child.exe"
                  Arguments="--reconfigure"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall LOTUS Child"
                  Description="Remove LOTUS Agent Child"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\LotusAlgebra\LOTUS Agent Child"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Optional desktop shortcut — user can toggle during install. -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut"
                 Guid="F0B4D7A8-9C52-4C3E-9F8A-23B43A7E11D4">
        <Condition>INSTALLDESKTOPSHORTCUT = 1</Condition>
        <Shortcut Id="DesktopLotusShortcut"
                  Name="LOTUS Child"
                  Description="Launch the LOTUS Agent child process"
                  Target="[INSTALLFOLDER]lotus-child.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\LotusAlgebra\LOTUS Agent Child"
                       Name="desktop_shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <!-- ─── Feature tree (single feature — all-or-nothing) ────────── -->
    <Feature Id="Complete"
             Title="LOTUS Agent Child"
             Description="The core child binary + Start Menu shortcuts."
             Level="1"
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- ─── UI: standard WiX "Minimal" flow with license + path-pick ──
         WixUI_InstallDir gives us: Welcome → License → Install Location
         → Ready → Install → Progress → Finish. -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf"
                 Value="packaging\windows\LICENSE.rtf" />
    <!-- banner.bmp (493x58) and dialog.bmp (493x312) are optional;
         WiX falls back to its own stock art if these are absent. To
         brand the installer, drop the two BMPs next to LICENSE.rtf and
         uncomment the WixVariable entries below.
    <WixVariable Id="WixUIBannerBmp" Value="packaging\windows\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="packaging\windows\dialog.bmp" />
    -->

    <!-- Launch child after install (checkbox on Finish page, default ON). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch LOTUS Child now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]lotus-child.exe" />
    <CustomAction Id="LaunchApplication"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
